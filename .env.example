PORT=3000
NODE_ENV=development
# Change this one value to switch RPCs, assets, 1Click, relayer, oracle, and database together.
NETWORK_ENVIRONMENT=testnet
API_KEY_ENCRYPTION_KEY=replace-with-a-random-secret-used-to-encrypt-api-keys-for-webhook-signing

# RPC/API URLs are derived from NETWORK_ENVIRONMENT. Optional overrides must match it.
# BASE_RPC_URL=https://sepolia.base.org
EVM_SUBMITTER_PRIVATE_KEY=

# SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_FEE_PAYER_PRIVATE_KEY=

# NEAR_RPC_URL=https://rpc.testnet.near.org
# Testnet relayer is derived automatically. Mainnet requires an explicit existing account ID.
NEAR_RELAYER_ACCOUNT_ID=
NEAR_RELAYER_PRIVATE_KEY=

# ONECLICK_API_URL=https://www.usetidepool.tech
ONECLICK_PARTNER_JWT=
# DATABASE_PATH is optional; defaults to an environment-specific database file.
